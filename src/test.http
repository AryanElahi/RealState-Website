# Manual requests for the REST Client extension.
# Put a token from /auth/login in @token. Never commit real tokens.
@baseUrl = http://localhost:3000/api/V1
@token = PASTE_ACCESS_TOKEN_HERE

### Search confirmed announcements
POST {{baseUrl}}/announce/search
Content-Type: application/json

{
    "type": "sell"
}

### Search regions
POST {{baseUrl}}/announce/search_region
Content-Type: application/json

{
    "name": "مب"
}

### My announcements
GET {{baseUrl}}/auth/getAnnouncements
Authorization: Bearer {{token}}
