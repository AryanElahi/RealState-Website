# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=production
PORT=3000

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zhinge

REDIS_URL=redis://127.0.0.1:6379

# Two different long random values, for example from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d
JWT_ISSUER=zhinge

# SMS.ir credentials
SMSIR_API_KEY=
SMSIR_SECRET_KEY=
# true = print verification codes in the server log instead of sending SMS (development only)
SMS_DRY_RUN=false
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Public base URL of this API, used to build photo URLs (no trailing slash)
PUBLIC_URL=https://api.example.com
# Folder where uploaded photos are stored (defaults to src/photos)
PHOTOS_DIR=

# Comma separated list of frontend origins allowed by CORS
CORS_ORIGIN=https://example.com
# Set to true when running behind nginx or another reverse proxy
TRUST_PROXY=false
